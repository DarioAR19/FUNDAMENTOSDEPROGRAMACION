#include <iostream>
using namespace std;

int main() {
    int N;
    float notas[100];
    float suma = 0, promedio, mayor, menor;

    do {
        cout << "Ingrese la cantidad de estudiantes: ";
        cin >> N;

        if (N < 1 || N > 100) {
            cout << "Cantidad incorrecta" << endl;
        }

    } while (N < 1 || N > 100);

    for (int i = 0; i < N; i++) {

        do {
            cout << "Nota estudiante " << i + 1 << ": ";
            cin >> notas[i];

            if (notas[i] < 0 || notas[i] > 100) {
                cout << "Nota incorrecta" << endl;
            }

        } while (notas[i] < 0 || notas[i] > 100);
    }

    mayor = notas[0];
    menor = notas[0];

    for (int i = 0; i < N; i++) {

        suma = suma + notas[i];

        if (notas[i] > mayor) {
            mayor = notas[i];
        }

        if (notas[i] < menor) {
            menor = notas[i];
        }
    }

    promedio = suma / N;

    cout << "\nNOTAS REGISTRADAS" << endl;

    for (int i = 0; i < N; i++) {
        cout << notas[i] << " ";
    }

    cout << "\n\nPromedio general: " << promedio << endl;
    cout << "Nota mayor: " << mayor << endl;
    cout << "Nota menor: " << menor << endl;

    return 0;
}