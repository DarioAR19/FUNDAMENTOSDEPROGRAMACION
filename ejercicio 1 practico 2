#include <iostream>
#include <string>
using namespace std;

int main() {
    string nombre, carrera;
    int edad, semestre;

    cout << "Ingrese su nombre completo: ";
    getline(cin, nombre);

    cout << "Ingrese su edad: ";
    cin >> edad;
    cin.ignore();

    cout << "Ingrese su carrera: ";
    getline(cin, carrera);

    cout << "Ingrese su semestre: ";
    cin >> semestre;

    cout << "\nDATOS DEL ESTUDIANTE" << endl;
    cout << "Nombre: " << nombre << endl;
    cout << "Edad: " << edad << endl;
    cout << "Carrera: " << carrera << endl;
    cout << "Semestre: " << semestre << endl;

    return 0;
}