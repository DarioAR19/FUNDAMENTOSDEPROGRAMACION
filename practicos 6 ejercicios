#include <iostream>
#include <string>
using namespace std;

bool validarFecha(int d, int m, int a);
string estacion(int dia, int mes);

int main() {
    int dia, mes, anio;

    cout << "Ingrese dia, mes y anio: ";
    cin >> dia >> mes >> anio;

    if (validarFecha(dia, mes, anio))
        cout << "Estacion: " << estacion(dia, mes);
    else
        cout << "Fecha incorrecta";

    return 0;
}

bool validarFecha(int d, int m, int a) {
    int dias[] = {31, 28, 31, 30, 31, 30,
                  31, 31, 30, 31, 30, 31};

    if (m < 1 || m > 12 || a < 1)
        return false;

    if (a % 400 == 0 || (a % 4 == 0 && a % 100 != 0))
        dias[1] = 29;

    return d >= 1 && d <= dias[m - 1];
}

string estacion(int dia, int mes) {
    int fecha = mes * 100 + dia;

    if (fecha >= 921 && fecha < 1221)
        return "Primavera";
    else if (fecha >= 1221 || fecha < 321)
        return "Verano";
    else if (fecha >= 321 && fecha < 621)
        return "Otono";
    else
        return "Invierno";
}

#include <iostream>
#include <cmath>
using namespace std;

void resolver(double a, double b, double c);

int main() {
    double a, b, c;

    cout << "Ingrese a, b y c: ";
    cin >> a >> b >> c;

    resolver(a, b, c);

    return 0;
}

void resolver(double a, double b, double c) {
    double d, real, imaginaria;

    if (a == 0) {
        if (b != 0)
            cout << "X = " << -c / b;
        else if (c == 0)
            cout << "Infinitas soluciones";
        else
            cout << "No existe solucion";

        return;
    }

    d = b * b - 4 * a * c;

    if (d > 0) {
        cout << "X1 = " << (-b + sqrt(d)) / (2 * a) << endl;
        cout << "X2 = " << (-b - sqrt(d)) / (2 * a) << endl;
    }
    else if (d == 0) {
        cout << "Raiz doble: " << -b / (2 * a);
    }
    else {
        real = -b / (2 * a);
        imaginaria = sqrt(-d) / (2 * abs(a));

        cout << "X1 = " << real << " + "
             << imaginaria << "i" << endl;

        cout << "X2 = " << real << " - "
             << imaginaria << "i" << endl;
    }
}

#include <iostream>
using namespace std;

void sistema(double a, double b, double c,
             double d, double e);

int main() {
    double a, b, c, d, e;

    cout << "Ingrese a, b y c: ";
    cin >> a >> b >> c;

    cout << "Ingrese d y e: ";
    cin >> d >> e;

    sistema(a, b, c, d, e);

    return 0;
}

void sistema(double a, double b, double c,
             double d, double e) {

    double det = a * e - b * d;
    double detX = c * e - b * d;
    double detY = a * d - c * d;

    if (det != 0) {
        cout << "X = " << detX / det << endl;
        cout << "Y = " << detY / det << endl;
    }
    else if ((a == 0 && b == 0 && c != 0) ||
             detX != 0 || detY != 0) {
        cout << "No existe solucion";
    }
    else {
        cout << "Infinitas soluciones";
    }
}

#include <iostream>
#include <iomanip>
using namespace std;

void calcularCompra(int h, int hq, int p, int s);

int main() {
    int hamburguesas, queso, papas, soda;

    cout << "Cantidad de hamburguesas: ";
    cin >> hamburguesas;

    cout << "Cantidad de hamburguesas con queso: ";
    cin >> queso;

    cout << "Cantidad de papas fritas: ";
    cin >> papas;

    cout << "Cantidad de sodas: ";
    cin >> soda;

    if (hamburguesas >= 0 && queso >= 0 &&
        papas >= 0 && soda >= 0)
        calcularCompra(hamburguesas, queso, papas, soda);
    else
        cout << "Cantidad incorrecta";

    return 0;
}

void calcularCompra(int h, int hq, int p, int s) {
    float totalH = h * 3;
    float totalHQ = hq * 5;
    float totalP = p * 2;
    float totalS = s * 2.5;

    float total = totalH + totalHQ + totalP + totalS;

    cout << fixed << setprecision(2);

    cout << "\n--- RESUMEN DE COMPRA ---" << endl;
    cout << "Hamburguesas: " << h << " | Bs " << totalH << endl;
    cout << "Con queso: " << hq << " | Bs " << totalHQ << endl;
    cout << "Papas fritas: " << p << " | Bs " << totalP << endl;
    cout << "Sodas: " << s << " | Bs " << totalS << endl;

    cout << "Cantidad total: " << h + hq + p + s << endl;
    cout << "TOTAL A PAGAR: Bs " << total << endl;
}

#include <iostream>
using namespace std;

float cuadrado(float L);
float circulo(float R);
float triangulo(float B, float H);

int main() {
    int opcion;
    float L, R, B, H;

    cout << "--- MENU DE FIGURAS ---" << endl;
    cout << "1. Cuadrado" << endl;
    cout << "2. Circulo" << endl;
    cout << "3. Triangulo" << endl;

    cout << "Seleccione una opcion: ";
    cin >> opcion;

    switch (opcion) {
        case 1:
            cout << "Ingrese el lado: ";
            cin >> L;

            if (L > 0)
                cout << "Area: " << cuadrado(L);
            else
                cout << "Medida incorrecta";
            break;

        case 2:
            cout << "Ingrese el radio: ";
            cin >> R;

            if (R > 0)
                cout << "Area: " << circulo(R);
            else
                cout << "Medida incorrecta";
            break;

        case 3:
            cout << "Ingrese base y altura: ";
            cin >> B >> H;

            if (B > 0 && H > 0)
                cout << "Area: " << triangulo(B, H);
            else
                cout << "Medidas incorrectas";
            break;

        default:
            cout << "Opcion incorrecta";
    }

    return 0;
}

float cuadrado(float L) {
    return L * L;
}

float circulo(float R) {
    return 3.14159265 * R * R;
}

float triangulo(float B, float H) {
    return (B * H) / 2;
}

#include <iostream>
#include <string>
using namespace std;

float leerNota();
float calcularNota(float p1, float p2, float practico,
                   float final, int faltas);
void mostrarResultado(string nombre, float nota);

int main() {
    string nombre;
    float p1, p2, practico, final, NF;
    int faltas;
    char continuar;

    do {
        cout << "\nNombre del estudiante: ";
        getline(cin >> ws, nombre);

        cout << "Primer parcial: ";
        p1 = leerNota();

        cout << "Segundo parcial: ";
        p2 = leerNota();

        cout << "Examen practico: ";
        practico = leerNota();

        cout << "Examen final: ";
        final = leerNota();

        do {
            cout << "Cantidad de faltas: ";
            cin >> faltas;
        } while (faltas < 0 || faltas > 48);

        NF = calcularNota(p1, p2, practico, final, faltas);

        mostrarResultado(nombre, NF);

        do {
            cout << "\nHay mas alumnos? (S/N): ";
            cin >> continuar;
        } while (continuar != 'S' && continuar != 's' &&
                 continuar != 'N' && continuar != 'n');

    } while (continuar == 'S' || continuar == 's');

    return 0;
}

float leerNota() {
    float nota;

    do {
        cin >> nota;

        if (nota < 0 || nota > 100)
            cout << "Ingrese una nota valida: ";

    } while (nota < 0 || nota > 100);

    return nota;
}

float calcularNota(float p1, float p2, float practico,
                   float final, int faltas) {

    if (faltas > 48 * 0.20) {
        final = 0;
        cout << "Examen final anulado por faltas" << endl;
    }

    return p1 * 0.20 + p2 * 0.20 +
           practico * 0.20 + final * 0.40;
}

void mostrarResultado(string nombre, float nota) {
    cout << "\n--- RESULTADO ACADEMICO ---" << endl;
    cout << "Estudiante: " << nombre << endl;
    cout << "Promedio final: " << nota << endl;

    if (nota >= 51)
        cout << "APROBADO" << endl;
    else
        cout << "REPROBADO" << endl;
}
