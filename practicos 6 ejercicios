void calcularCosto(float P);

int main() {
    float P;

    cout << "Ingrese el peso en gramos: ";
    cin >> P;

    calcularCosto(P);

    return 0;
}

void calcularCosto(float P) {
    if (P <= 0)
        cout << "Peso incorrecto";
    else if (P <= 50)
        cout << "Costo: Bs 1.50";
    else if (P <= 100)
        cout << "Costo: Bs 4.00";
    else if (P <= 200)
        cout << "Costo: Bs 6.00";
    else if (P <= 350)
        cout << "Costo: Bs 10.50";
    else if (P <= 500)
        cout << "Costo: Bs 15.00";
    else
        cout << "NO PUEDE ENVIAR COMO CARTA";
}

#include <iostream>
#include <cmath>
using namespace std;

void calcularRaices(double a, double b, double c);

int main() {
    double a, b, c;

    cout << "Ingrese a, b y c: ";
    cin >> a >> b >> c;

    calcularRaices(a, b, c);

    return 0;
}

void calcularRaices(double a, double b, double c) {
    double d, x1, x2;

    if (a == 0) {
        cout << "No es una ecuacion cuadratica";
        return;
    }

    d = b * b - 4 * a * c;

    if (d >= 0) {
        x1 = (-b + sqrt(d)) / (2 * a);
        x2 = (-b - sqrt(d)) / (2 * a);

        cout << "X1 = " << x1 << endl;
        cout << "X2 = " << x2 << endl;
    }
    else {
        cout << "No existen soluciones reales";
    }
}

#include <iostream>
using namespace std;

void desglosar(int N);

int main() {
    int N;

    cout << "Ingrese un entero positivo menor a 10000: ";
    cin >> N;

    if (N > 0 && N < 10000)
        desglosar(N);
    else
        cout << "Numero incorrecto";

    return 0;
}

void desglosar(int N) {
    int u, d, c, m;

    u = N % 10;
    d = (N / 10) % 10;
    c = (N / 100) % 10;
    m = N / 1000;

    cout << "Unidades: " << u << endl;
    cout << "Decenas: " << d << endl;
    cout << "Centenas: " << c << endl;
    cout << "Unidades de mil: " << m << endl;
}

#include <iostream>
#include <iomanip>
using namespace std;

int convertirSegundos(int h, int m, int s);
bool validar(int h, int m, int s);
void diferencia(int t1, int t2);

int main() {
    int h1, m1, s1, h2, m2, s2;

    cout << "Primer horario (hora minuto segundo): ";
    cin >> h1 >> m1 >> s1;

    cout << "Segundo horario (hora minuto segundo): ";
    cin >> h2 >> m2 >> s2;

    if (validar(h1, m1, s1) && validar(h2, m2, s2)) {
        diferencia(convertirSegundos(h1, m1, s1),
                   convertirSegundos(h2, m2, s2));
    }
    else {
        cout << "Horario incorrecto";
    }

    return 0;
}

bool validar(int h, int m, int s) {
    return h >= 0 && h < 24 &&
           m >= 0 && m < 60 &&
           s >= 0 && s < 60;
}

int convertirSegundos(int h, int m, int s) {
    return h * 3600 + m * 60 + s;
}

void diferencia(int t1, int t2) {
    if (t2 < t1) {
        cout << "El segundo horario debe ser posterior";
        return;
    }

    int total = t2 - t1;
    int h = total / 3600;
    int m = (total % 3600) / 60;
    int s = total % 60;

    cout << "Tiempo transcurrido: ";
    cout << h << ":" << setfill('0')
         << setw(2) << m << ":"
         << setw(2) << s;
}


