#include <iostream>
using namespace std;

int main() {
    float compra, descuento, total;

    cout << "Ingrese el monto de la compra: ";
    cin >> compra;

    if (compra > 100) {
        descuento = compra * 0.10;
    }
    else {
        descuento = 0;
    }

    total = compra - descuento;

    cout << "Monto de compra: " << compra << " Bs" << endl;
    cout << "Descuento: " << descuento << " Bs" << endl;
    cout << "Total a pagar: " << total << " Bs" << endl;

    return 0;
}