unsigned long long convertir() {
    string binario;

    do {
        cout << "Ingrese un numero binario: ";
        cin >> binario;

    } while (binario.find_first_not_of("01") != string::npos
             || binario.length() > 64);

    unsigned long long decimal = 0;

    for (int i = 0; i < binario.length(); i++) {
        decimal = decimal * 2 + (binario[i] - '0');
    }

