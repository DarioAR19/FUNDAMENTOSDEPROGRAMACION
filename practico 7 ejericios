#include <iostream>
#include <cmath>
using namespace std;

void resolver(double a, double b, double c);

int main() {
    double a, b, c;

    cout << "Ingrese a, b y c: ";
    cin >> a >> b >> c;

    resolver(a, b, c);

    return 0;
}

void resolver(double a, double b, double c) {
    double d, x1, x2, real, imaginaria;

    if (a == 0) {
        cout << "No es una ecuacion cuadratica";
        return;
    }

    d = b * b - 4 * a * c;

    if (d > 0) {
        x1 = (-b + sqrt(d)) / (2 * a);
        x2 = (-b - sqrt(d)) / (2 * a);

        cout << "X1 = " << x1 << endl;
        cout << "X2 = " << x2 << endl;
    }
    else if (d == 0) {
        x1 = -b / (2 * a);

        cout << "Raiz doble: " << x1;
    }
    else {
        real = -b / (2 * a);
        imaginaria = sqrt(-d) / (2 * abs(a));

        cout << "X1 = " << real << " + "
             << imaginaria << "i" << endl;

        cout << "X2 = " << real << " - "
             << imaginaria << "i" << endl;
    }
}


