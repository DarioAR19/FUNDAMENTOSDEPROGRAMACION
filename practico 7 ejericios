#include <iostream>
using namespace std;

bool bisiesto(int anio);
int diasMes(int mes, int anio);
bool validarFecha(int d, int m, int a);
long long convertirDias(int d, int m, int a);
void diferencia(int d1, int m1, int a1,
                int d2, int m2, int a2);

int main() {
    int d1, m1, a1, d2, m2, a2;

    cout << "Ingrese primera fecha (dia mes anio): ";
    cin >> d1 >> m1 >> a1;

    cout << "Ingrese segunda fecha (dia mes anio): ";
    cin >> d2 >> m2 >> a2;

    diferencia(d1, m1, a1, d2, m2, a2);

    return 0;
}

bool bisiesto(int anio) {
    return anio % 400 == 0 ||
           (anio % 4 == 0 && anio % 100 != 0);
}

int diasMes(int mes, int anio) {
    int dias[] = {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    if (mes == 2 && bisiesto(anio))
        return 29;

    return dias[mes - 1];
}

bool validarFecha(int d, int m, int a) {
    if (a < 1 || m < 1 || m > 12)
        return false;

    return d >= 1 && d <= diasMes(m, a);
}

long long convertirDias(int d, int m, int a) {
    long long anios = a - 1;

    long long total = anios * 365
                    + anios / 4
                    - anios / 100
                    + anios / 400;

    for (int i = 1; i < m; i++) {
        total += diasMes(i, a);
    }

    return total + d;
}

void diferencia(int d1, int m1, int a1,
                int d2, int m2, int a2) {

    if (!validarFecha(d1, m1, a1) ||
        !validarFecha(d2, m2, a2)) {
        cout << "Fecha incorrecta";
        return;
    }

    long long total1 = convertirDias(d1, m1, a1);
    long long total2 = convertirDias(d2, m2, a2);

    long long dias = total2 - total1;

    if (dias < 0)
        dias = -dias;

    cout << "Dias transcurridos: " << dias;
}