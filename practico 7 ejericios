double serie(int x, int n) {
    double suma = 0, termino = x;
    int signo = 1;

    for (int i = 1; i <= n; i += 2) {
        suma += signo * termino;

        termino = termino * x * x /
                  ((i + 1.0) * (i + 2.0));

