#include <iostream>
using namespace std;

void SISTEMA(double A, double B, double C,
             double D, double E, double F,
             double &X, double &Y);

int main() {
    double A, B, C, D, E, F, X, Y;

    cout << "Ingrese A, B y C: ";
    cin >> A >> B >> C;

    cout << "Ingrese D, E y F: ";
    cin >> D >> E >> F;

    SISTEMA(A, B, C, D, E, F, X, Y);

    return 0;
}

void SISTEMA(double A, double B, double C,
             double D, double E, double F,
             double &X, double &Y) {

    double det = A * E - B * D;

    if (det != 0) {
        X = (B * F - C * E) / det;
        Y = (C * D - A * F) / det;

        cout << "X = " << X << endl;
        cout << "Y = " << Y << endl;
    }
    else {
        cout << "El sistema no tiene solucion unica";
    }
}

