// EJERCICIO 7: Alertas de stock y codigos
string generarCodigo(string nombre) {
    if (nombre.length() >= 3)
        return nombre.substr(0, 3);

    return "Sin codigo";
}

void mostrarStockBajo(string p[], string m[],
                      int c[], int n) {

    int contador = 0;

    for (int i = 0; i < n; i++) {
        if (c[i] < 5) {
            mostrarProducto(p, m, c, i);

            cout << "Codigo: "
                 << generarCodigo(p[i]) << endl;

            contador++;
        }
    }

    cout << "Productos con stock bajo: "
         << contador << endl;
}

// EJERCICIO 8: Consultar por marca
void buscarPorMarca(string p[], string m[],
                    int c[], int n) {

    string marca = leerTexto("Marca a buscar: ");
    int contador = 0;

    for (int i = 0; i < n; i++) {
        if (m[i].compare(marca) == 0) {
            mostrarProducto(p, m, c, i);
            contador++;
        }
    }

    if (contador == 0)
        cout << "Marca no encontrada\n";
    else
        cout << "Coincidencias: " << contador << endl;
}

// EJERCICIO 9: Corregir nombres
void corregirNombre(string p[], string m[], int n) {

    int i = localizar(p, m, n);

    if (i == -1)
        return;

    string nuevo = p[i];

    cout << "1. Reemplazar fragmento\n";
    cout << "2. Agregar prefijo PRO-\n";
    cout << "3. Quitar prefijo PRO-\n";

    int op = leerEntero("Opcion: ");

    if (op == 1) {

        string anterior = leerTexto("Fragmento a reemplazar: ");
        size_t pos = nuevo.find(anterior);

        if (anterior.empty() || pos == string::npos) {
            cout << "Fragmento no encontrado\n";
            return;
        }

        string reemplazo = leerTexto("Nuevo fragmento: ");

        nuevo.replace(pos, anterior.length(), reemplazo);
    }
    else if (op == 2 && nuevo.find("PRO-") != 0) {

        nuevo.insert(0, "PRO-");
    }
    else if (op == 3 && nuevo.find("PRO-") == 0) {

        nuevo.erase(0, 4);
    }
    else {
        cout << "Operacion no permitida\n";
        return;
    }

    int repetido = buscarExacto(p, m, n, nuevo, m[i]);

    if (nuevo.length() < 3 ||
        nuevo.find("PRO-PRO-") == 0 ||
        (repetido != -1 && repetido != i)) {

        cout << "Nombre invalido o repetido\n";
        return;
    }

    cout << "Nombre anterior: " << p[i] << endl;

    p[i] = nuevo;

    cout << "Nombre nuevo: " << p[i] << endl;
}

// EJERCICIO 10: Resumen del inventario
void mostrarResumen(string p[], string m[],
                    int c[], int n) {

    long long total = 0;
    int mayor = 0;

    for (int i = 0; i < n; i++) {
        total = total + c[i];

        if (c[i] > c[mayor]) {
            mayor = i;
        }
    }

    cout << "\n--- RESUMEN ---\n";
    cout << "Productos distintos: " << n << endl;
    cout << "Total de unidades: " << total << endl;

    if (n > 0) {
        cout << "Producto con mayor stock: ";
        mostrarProducto(p, m, c, mayor);
    }
    else {
        cout << "No hay productos registrados\n";
    }
}

