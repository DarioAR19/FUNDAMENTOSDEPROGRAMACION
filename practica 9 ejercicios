// Funciones auxiliares
string leerTexto(string mensaje) {
    string texto;
    cout << mensaje;

    if (!getline(cin, texto))
        exit(0);

    return texto;
}

int leerEntero(string mensaje) {
    int valor;
    char extra;

    while (true) {
        istringstream entrada(leerTexto(mensaje));

        if (entrada >> valor && !(entrada >> extra))
            return valor;

        cout << "Ingrese un entero valido\n";
    }
}

// Busqueda exacta
int buscarExacto(string p[], string m[], int n,
                 string nombre, string marca) {

    for (int i = 0; i < n; i++) {
        if (p[i].compare(nombre) == 0 &&
            m[i].compare(marca) == 0) {
            return i;
        }
    }

    return -1;
}

int localizar(string p[], string m[], int n) {
    string nombre = leerTexto("Nombre: ");
    string marca = leerTexto("Marca: ");

    int i = buscarExacto(p, m, n, nombre, marca);

    if (i == -1)
        cout << "Producto no encontrado\n";

    return i;
}

// EJERCICIO 1: Registrar un producto
void registrarProducto(string p[], string m[],
                       int c[], int &n) {

    if (n >= 20)
        return;

    string nombre, marca;
    int stock;

    do {
        nombre = leerTexto("Nombre: ");
        marca = leerTexto("Marca: ");

        if (nombre.empty() || marca.empty() ||
            nombre.length() < 3 || marca.length() < 3) {
            cout << "Minimo tres caracteres\n";
        }
        else if (buscarExacto(p, m, n, nombre, marca) != -1) {
            cout << "Producto repetido\n";
        }
        else {
            break;
        }

    } while (true);

    do {
        stock = leerEntero("Cantidad: ");
    } while (stock < 0);

    p[n] = nombre;
    m[n] = marca;
    c[n] = stock;

    mostrarProducto(p, m, c, n);
    n++;
}

void mostrarProducto(string p[], string m[],
                     int c[], int i) {

    cout << i << ". " << p[i]
         << " | " << m[i]
         << " | Stock: " << c[i] << endl;
}

// EJERCICIO 2: Registrar varios productos
void registrarProductos(string p[], string m[],
                        int c[], int &n) {

    if (n == 20) {
        cout << "Inventario lleno\n";
        return;
    }

    int k = leerEntero("Cantidad de productos: ");

    if (k < 1 || k > 20 - n) {
        cout << "Cantidad incorrecta\n";
        return;
    }

    for (int i = 0; i < k; i++) {
        registrarProducto(p, m, c, n);
    }

    mostrarProductos(p, m, c, n);
}

void mostrarProductos(string p[], string m[],
                      int c[], int n) {

    if (n == 0)
        cout << "Inventario vacio\n";

    for (int i = 0; i < n; i++) {
        mostrarProducto(p, m, c, i);
    }
}

// EJERCICIO 3: Buscar productos
void buscarProductos(string p[], string m[],
                     int c[], int n) {

    string palabra = leerTexto("Buscar nombre: ");
    int encontrados = 0;

    if (palabra.empty()) {
        cout << "Busqueda vacia\n";
        return;
    }

    for (int i = 0; i < n; i++) {
        if (p[i].find(palabra) != string::npos) {
            mostrarProducto(p, m, c, i);
            encontrados++;
        }
    }

    if (encontrados == 0)
        cout << "Sin coincidencias\n";
}

// EJERCICIO 4: Actualizar stock
void actualizarStock(string p[], string m[],
                     int c[], int n) {

    int i = localizar(p, m, n);

    if (i == -1)
        return;

    int nuevo = leerEntero("Nuevo stock: ");

    if (nuevo < 0) {
        cout << "Stock invalido\n";
        return;
    }

    cout << "Stock anterior: " << c[i] << endl;

    c[i] = nuevo;

    cout << "Nuevo stock: " << c[i] << endl;
}

// EJERCICIO 5: Registrar una venta
void registrarVenta(string p[], string m[],
                    int c[], int n) {

    int i = localizar(p, m, n);

    if (i == -1)
        return;

    int venta = leerEntero("Unidades a vender: ");

    if (venta <= 0 || venta > c[i]) {
        cout << "Venta invalida\n";
        return;
    }

    c[i] = c[i] - venta;

    cout << "Stock restante: " << c[i] << endl;
}

// EJERCICIO 6: Reponer existencias
void reponerStock(string p[], string m[],
                  int c[], int n) {

    string nombre = leerTexto("Nombre: ");
    string marca = leerTexto("Marca: ");
    int i = -1;

    for (int j = 0; j < n; j++) {
        if (p[j].find(nombre) == 0 &&
            p[j].length() == nombre.length() &&
            m[j].compare(marca) == 0) {

            i = j;
            break;
        }
    }

    if (i == -1) {
        cout << "Producto no encontrado\n";
        return;
    }

    int recibido = leerEntero("Unidades recibidas: ");

    if (recibido <= 0 || recibido > INT_MAX - c[i]) {
        cout << "Reposicion invalida\n";
