#include <iostream>
using namespace std;

int main() {
    int N;
    unsigned long long a = 1, b = 1, c;

    do {
        cout << "Ingrese N entre 0 y 92: ";
        cin >> N;
    } while (N < 0 || N > 92);

    if (N == 0 || N == 1) {
        cout << "Fibonacci: 1";
    }
    else {
        for (int i = 2; i <= N; i++) {
            c = a + b;
            a = b;
            b = c;
        }

        cout << "Fibonacci: " << b;
    }

    return 0;
}
#include <iostream>
#include <iomanip>
#include <thread>
#include <chrono>
using namespace std;

int main() {
    int h = 0, m = 0, s = 0;

    while (true) {

        cout << "\r" << setfill('0')
             << setw(2) << h << ":"
             << setw(2) << m << ":"
             << setw(2) << s << flush;

        this_thread::sleep_for(chrono::seconds(1));

        s++;

        if (s == 60) {
            s = 0;
            m++;
        }

        if (m == 60) {
            m = 0;
            h++;
        }

        if (h == 24) {
            h = 0;
        }
    }

    return 0;
}
#include <iostream>
using namespace std;

int main() {
    int N;
    bool primo = true;

    cout << "Ingrese un numero entero: ";
    cin >> N;

    if (N <= 1) {
        primo = false;
    }

    for (int i = 2; i <= N / i && primo; i++) {
        if (N % i == 0) {
            primo = false;
        }
    }

    if (primo) {
        cout << "El numero es primo";
    }
    else {
        cout << "El numero no es primo";
    }

    return 0;
}