#include <iostream>
using namespace std;

int main() {
    int A, B, residuo;

    cout << "Ingrese dos enteros positivos: ";
    cin >> A >> B;

    if (A <= 0 || B <= 0) {
        cout << "Numeros incorrectos";
        return 0;
    }

    while (B != 0) {
        residuo = A % B;
        A = B;
        B = residuo;
    }

    cout << "MCD: " << A;

    return 0;
}
#include <iostream>
using namespace std;

int main() {
    int A, B, x, y, residuo, MCD;
    long long MCM;

    cout << "Ingrese dos enteros positivos: ";
    cin >> A >> B;

    if (A <= 0 || B <= 0) {
        cout << "Numeros incorrectos";
        return 0;
    }

    x = A;
    y = B;

    while (y != 0) {
        residuo = x % y;
        x = y;
        y = residuo;
    }

    MCD = x;
    MCM = (long long)A * B / MCD;

    cout << "MCM: " << MCM;

    return 0;
}
