bool existe(int b[], int m, int numero) {
    for (int i = 0; i < m; i++) {
        if (b[i] == numero)
            return true;
    }

    return false;
}

int eliminarDuplicados(int a[], int b[], int n) {
    int m = 0;

    for (int i = 0; i < n; i++) {
        if (!existe(b, m, a[i])) {
            b[m] = a[i];
            m++;
        }
    }

    return m;
}

