using namespace std;

void leer(int v[], int &n);
void intercalar(int a[], int b[], int c[], int n, int m);
void mostrar(int v[], int n);

int main() {
    int a[100], b[100], c[200];
    int n, m;

    cout << "Vector A" << endl;
    leer(a, n);

    cout << "Vector B" << endl;
    leer(b, m);

    intercalar(a, b, c, n, m);

    cout << "Vector intercalado: ";
    mostrar(c, n + m);

    return 0;
}

void leer(int v[], int &n) {
    do {
        cout << "Cantidad de elementos: ";
        cin >> n;
    } while (n < 1 || n > 100);

    for (int i = 0; i < n; i++) {
        do {
            cout << "Ingrese valor en orden ascendente: ";
            cin >> v[i];

            if (i > 0 && v[i] < v[i - 1])
                cout << "Valor incorrecto" << endl;

        } while (i > 0 && v[i] < v[i - 1]);
    }
}

void intercalar(int a[], int b[], int c[], int n, int m) {
    int i = 0, j = 0, k = 0;

    while (i < n && j < m) {
        if (a[i] <= b[j]) {
            c[k] = a[i];
            i++;
        }
        else {
            c[k] = b[j];
            j++;
        }

        k++;
    }

    while (i < n) {
        c[k++] = a[i++];
    }

    while (j < m) {
        c[k++] = b[j++];
    }
}

void mostrar(int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
