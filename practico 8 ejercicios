void ordenar(string nombres[], float notas[], int n) {
    string auxNombre;
    float auxNota;

    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {

            if (nombres[j] > nombres[j + 1]) {

                auxNombre = nombres[j];
                nombres[j] = nombres[j + 1];
                nombres[j + 1] = auxNombre;

                auxNota = notas[j];
                notas[j] = notas[j + 1];
                notas[j + 1] = auxNota;
            }
        }
    }
}

void mostrarMejor(string nombres[], float notas[], int n) {

