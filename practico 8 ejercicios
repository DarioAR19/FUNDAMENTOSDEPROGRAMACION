#include <iostream>
using namespace std;

void leer(double a[], int &n);
double diferenciaAbsoluta(double x);
void calcular(double a[], int n, double &mayor,
              double &x, double &y);
void mostrar(double mayor, double x, double y);

int main() {
    double a[100], mayor, x, y;
    int n;

    leer(a, n);
    calcular(a, n, mayor, x, y);
    mostrar(mayor, x, y);

    return 0;
}

void leer(double a[], int &n) {
    do {
        cout << "Cantidad de elementos: ";
        cin >> n;
    } while (n < 2 || n > 100);

    for (int i = 0; i < n; i++) {
        cout << "Ingrese valor: ";
        cin >> a[i];
    }
}

double diferenciaAbsoluta(double x) {
    if (x < 0)
        return -x;

    return x;
}

void calcular(double a[], int n, double &mayor,
              double &x, double &y) {

    mayor = diferenciaAbsoluta(a[1] - a[0]);
    x = a[0];
    y = a[1];

    for (int i = 0; i < n - 1; i++) {
        double diferencia;

        diferencia = diferenciaAbsoluta(a[i + 1] - a[i]);

        if (diferencia > mayor) {
            mayor = diferencia;
            x = a[i];
            y = a[i + 1];
        }
    }
}

void mostrar(double mayor, double x, double y) {
    cout << "Mayor diferencia: " << mayor << endl;
    cout << "Elementos: " << x << " y " << y;
}

