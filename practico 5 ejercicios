#include <iostream>
using namespace std;

int main() {
    int N, digito, pares = 0;

    cout << "Ingrese un numero positivo: ";
    cin >> N;

    do {
        digito = N % 10;

        if (digito % 2 == 0) {
            pares++;
        }

        N = N / 10;

    } while (N > 0);

    cout << "Cantidad de digitos pares: " << pares;

    return 0;
}

#include <iostream>
using namespace std;

int main() {
    int N, original, digito;
    long long invertido = 0;

    cout << "Ingrese un numero positivo: ";
    cin >> N;

    original = N;

    while (N > 0) {
        digito = N % 10;
        invertido = invertido * 10 + digito;
        N = N / 10;
    }

    if (original == invertido) {
        cout << "El numero es capicua";
    }
    else {
        cout << "El numero no es capicua";
    }

    return 0;
}
#include <iostream>
#include <string>
using namespace std;

int main() {
    string N;
    int digito, complemento;

    cout << "Ingrese un numero: ";
    cin >> N;

    if (N.find_first_not_of("0123456789") != string::npos) {
        cout << "Numero incorrecto";
        return 0;
    }

    cout << "Complemento a 9: ";

    for (int i = 0; i < N.length(); i++) {
        digito = N[i] - '0';
        complemento = 9 - digito;

        cout << complemento;
    }

    return 0;
}
