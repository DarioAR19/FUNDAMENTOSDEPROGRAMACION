#include <iostream>
using namespace std;

int main() {
    int N, digito, suma = 0;

    cout << "Ingrese un numero positivo: ";
    cin >> N;

    while (N > 0) {
        digito = N % 10;
        suma = suma + digito;
        N = N / 10;
    }

    cout << "Suma de digitos: " << suma;

    return 0;
}
