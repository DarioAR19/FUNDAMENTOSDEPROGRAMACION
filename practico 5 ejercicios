#include <iostream>
using namespace std;

int main() {
    int N, digito;
    int total = 0, apps = 0, mayores = 0;
    float promedio;

    cout << "Ingrese el numero: ";
    cin >> N;

    do {
        digito = N % 10;

        total += digito;
        apps++;

        if (digito > 5) {
            mayores++;
        }

        N = N / 10;

    } while (N > 0);

    promedio = (float)total / apps;

    cout << "Total de horas: " << total << endl;
    cout << "Cantidad de aplicaciones: " << apps << endl;
    cout << "Apps que superan 5 horas: " << mayores << endl;
    cout << "Promedio de horas: " << promedio << endl;

    return 0;
}
#include <iostream>
using namespace std;

int main() {
    int N, digito, limite;
    int pares = 0, suma = 0;

    cout << "Ingrese el codigo numerico: ";
    cin >> N;

    cout << "Ingrese el valor minimo a superar: ";
    cin >> limite;

    do {
        digito = N % 10;

        suma += digito;

        if (digito % 2 == 0) {
            pares++;
        }

        N = N / 10;

    } while (N > 0);

    cout << "Digitos pares: " << pares << endl;
    cout << "Suma de digitos: " << suma << endl;

    if (pares >= 2 && suma > limite) {
        cout << "Codigo seguro";
    }
    else {
        cout << "Codigo inseguro";
    }

    return 0;
}
#include <iostream>
#include <string>
using namespace std;

int main() {
    string PIN;
    bool valido = true;

    cout << "Ingrese su PIN: ";
    cin >> PIN;

    if (PIN.length() != 4 ||
        PIN.find_first_not_of("0123456789") != string::npos) {
        valido = false;
    }

    for (int i = 1; i < PIN.length(); i++) {
        if (PIN[i] == PIN[i - 1]) {
            valido = false;
        }
    }

    if (valido) {
        cout << "PIN valido";
    }
    else {
        cout << "PIN invalido";
    }

    return 0;
}
